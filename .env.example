# Copy to .env and fill in for local development. On Vercel, set these in
# Project Settings → Environment Variables (VITE_* must be set at build time).

# Postgres (Supabase → Project Settings → Database → Connection string → "Transaction pooler")
DATABASE_URL=

# Clerk (dashboard.clerk.com → API keys). The publishable key is needed twice:
# once for the browser bundle (VITE_) and once for the API.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Stripe (dashboard.stripe.com → Developers → API keys) and the $99/month price ID
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=

# Resend (resend.com → API keys) and the sender for daily digests
RESEND_API_KEY=
PERMIT_CENTRAL_FROM_EMAIL="permitnative <onboarding@resend.dev>"

# Protects /api/cron/daily. Vercel Cron sends it automatically when set.
CRON_SECRET=

# Optional: where Stripe returns people after checkout. Defaults to the
# host the request came in on.
APP_URL=
