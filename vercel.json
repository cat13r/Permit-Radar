{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @workspace/permit-central run build && pnpm --filter @workspace/api-server run build",
  "outputDirectory": "artifacts/permit-central/dist/public",
  "functions": {
    "api/index.mjs": { "maxDuration": 300 }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cron/daily", "schedule": "15 13 * * *" }
  ]
}
